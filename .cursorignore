# Cursor 索引排除：减少索引量、加快响应
# 与 .gitignore 对齐，并补充仅 Cursor 需要忽略的路径

# 手动排除，如果需要修改，需要手动打开
# 短期内不会更新
build-logic/
gradle/
androidApp/
webApp/
iosApp/
core/analytics
core/app-build-config
core/cache/
core/logger/
core/navigation/
core/network/
core/network/test/
core/settings/




# Gradle & 构建
.gradle/
**/build/
.kotlin/
*/bin/

# IDE
.idea/
*.iml
.vscode/

# Android 构建/本地
.externalNativeBuild/
.cxx/
captures/
local.properties

# iOS / Xcode 构建与依赖
**/xcuserdata/
**/DerivedData/
iosApp/Pods/
*.xcworkspace/*
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
composeApp/composeApp.podspec

# Node / Web
node_modules/
kotlin-js-store/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境与本地数据
.env
.env.*
server/.env
server/.myhub/

# 系统与杂项
.DS_Store
Thumbs.db
composeApp/analytics/analytics_*.json
