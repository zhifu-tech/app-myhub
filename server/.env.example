# MyHub Server 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ============================================
# 服务器配置
# ============================================
SERVER_PORT=8083

# ============================================
# 数据库配置
# ============================================

# 选项 1: 使用 SQLite（默认，适合开发）
DB_TYPE=SQLITE
DB_PATH=.myhub/myhub.db

# 选项 2: 使用 PostgreSQL（适合生产环境）
# 取消下面的注释并填入实际值
# DB_TYPE=POSTGRESQL
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=myhub
# DB_USER=myhub_user
# DB_PASSWORD=myhub_password

# ============================================
# Docker Compose 专用配置（PostgreSQL 服务）
# ============================================
# 如果使用 docker-compose.yml，PostgreSQL 服务需要以下配置：
# POSTGRES_DB=myhub
# POSTGRES_USER=myhub_user
# POSTGRES_PASSWORD=myhub_password

# ============================================
# JWT 认证配置
# ============================================
# JWT Secret Key（必须设置，用于签名和验证 token）
# 生产环境请使用强随机字符串（至少 32 个字符）
# 生成方式：openssl rand -base64 32 或运行 ./scripts/generate-jwt-secret.sh
# 示例值（请替换为实际生成的密钥）：
JWT_SECRET=LpkmaSkAtM3WbGLWSsiMbwAJX+d+07QdILQKySTkhg4=

# JWT Issuer（Token 发行者，可选）
JWT_ISSUER=myhub-api

# JWT Audience（Token 受众，可选）
JWT_AUDIENCE=myhub-client
