-- 引用形态的 URL
CREATE TABLE card_metadata_link (
    card_id TEXT PRIMARY KEY NOT NULL,
    url TEXT NOT NULL,
    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_metadata_link_card_id ON card_metadata_link(card_id);

insertCardMetadataLink:
INSERT OR REPLACE INTO card_metadata_link (card_id, url)
VALUES (?, ?);
