-- 卡集
CREATE TABLE collection (
    id TEXT PRIMARY KEY NOT NULL,
    user_id TEXT NOT NULL,
    name TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE
);

CREATE INDEX idx_collection_user_id ON collection(user_id);

selectCollectionsByUserId:
SELECT * FROM collection
WHERE user_id = ?
ORDER BY updated_at DESC;

selectCollectionsByUserIdPaged:
SELECT * FROM collection
WHERE user_id = :user_id
ORDER BY updated_at DESC
LIMIT :limit OFFSET :offset;

selectCollectionsByUserIdPagedOldest:
SELECT * FROM collection
WHERE user_id = :user_id
ORDER BY updated_at  ASC
LIMIT :limit OFFSET :offset;

selectCollectionById:
SELECT * FROM collection
WHERE id = ?;

insertCollection:
INSERT OR REPLACE INTO collection (id, user_id, name, created_at, updated_at)
VALUES (?, ?, ?, ?, ?);

updateCollection:
UPDATE collection
SET name = ?,
    updated_at = ?
WHERE id = ?;

deleteCollection:
DELETE FROM collection
WHERE id = ?;

deleteCollectionsByUserId:
DELETE FROM collection
WHERE user_id = ?;
