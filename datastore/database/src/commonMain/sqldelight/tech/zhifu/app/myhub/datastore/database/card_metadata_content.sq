-- 正文/标题/摘要
CREATE TABLE card_metadata_content (
    card_id TEXT PRIMARY KEY NOT NULL,
    title TEXT,
    summary TEXT,
    content TEXT,
    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_metadata_content_card_id ON card_metadata_content(card_id);

insertCardMetadataContent:
INSERT OR REPLACE INTO card_metadata_content (card_id, title, summary, content)
VALUES (?, ?, ?, ?);
