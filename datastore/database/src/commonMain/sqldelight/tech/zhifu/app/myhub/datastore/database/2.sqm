-- 版本 2：添加用户关联
-- 从版本 1 迁移到版本 2：为所有业务表添加 user_id 字段

-- 1. 为所有业务表添加 user_id 字段
ALTER TABLE card ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE tag ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE template ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE card_tag ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE card_metadata ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE checklist_item ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE statistics ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE card_type_statistics ADD COLUMN user_id TEXT NOT NULL DEFAULT '';
ALTER TABLE tag_statistics ADD COLUMN user_id TEXT NOT NULL DEFAULT '';

-- 2. 数据迁移：为现有数据分配默认用户
-- 获取或创建默认用户（如果不存在）
-- 注意：这里假设默认用户ID为 'default-user'，实际应该从 user 表中获取第一个用户
-- 如果 user 表为空，需要先创建默认用户

-- 为现有数据分配默认用户
-- 首先尝试获取第一个用户，如果没有则使用 'default-user'
UPDATE card SET user_id = COALESCE((SELECT id FROM user LIMIT 1), 'default-user') WHERE user_id = '';
UPDATE tag SET user_id = COALESCE((SELECT id FROM user LIMIT 1), 'default-user') WHERE user_id = '';
UPDATE template SET user_id = COALESCE((SELECT id FROM user LIMIT 1), 'default-user') WHERE user_id = '';

-- 为关联表分配 user_id（通过关联的 card 获取）
UPDATE card_tag SET user_id = (SELECT user_id FROM card WHERE card.id = card_tag.card_id LIMIT 1) WHERE user_id = '';
UPDATE card_metadata SET user_id = (SELECT user_id FROM card WHERE card.id = card_metadata.card_id LIMIT 1) WHERE user_id = '';
UPDATE checklist_item SET user_id = (SELECT user_id FROM card WHERE card.id = checklist_item.card_id LIMIT 1) WHERE user_id = '';

-- 为统计表分配默认用户
UPDATE statistics SET user_id = COALESCE((SELECT id FROM user LIMIT 1), 'default-user') WHERE user_id = '';
UPDATE card_type_statistics SET user_id = COALESCE((SELECT id FROM user LIMIT 1), 'default-user') WHERE user_id = '';
UPDATE tag_statistics SET user_id = COALESCE((SELECT id FROM user LIMIT 1), 'default-user') WHERE user_id = '';

-- 3. 添加索引以优化查询性能
CREATE INDEX card_user_id_index ON card(user_id);
CREATE INDEX card_user_type_index ON card(user_id, type);
CREATE INDEX card_user_favorite_index ON card(user_id, is_favorite);
CREATE INDEX card_user_updated_index ON card(user_id, updated_at);
CREATE INDEX tag_user_id_index ON tag(user_id);
CREATE INDEX tag_user_name_index ON tag(user_id, name);
CREATE INDEX template_user_id_index ON template(user_id);
CREATE INDEX template_user_type_index ON template(user_id, card_type);
CREATE INDEX card_tag_user_id_index ON card_tag(user_id);
CREATE INDEX card_metadata_user_id_index ON card_metadata(user_id);
CREATE INDEX checklist_item_user_id_index ON checklist_item(user_id);
CREATE INDEX statistics_user_id_index ON statistics(user_id);
CREATE INDEX card_type_statistics_user_type_index ON card_type_statistics(user_id, card_type);
CREATE INDEX tag_statistics_user_tag_index ON tag_statistics(user_id, tag_name);

-- 4. 修改统计表的主键（可选，如果需要唯一约束）
-- 注意：SQLite 不支持直接修改主键，如果需要，需要重建表
-- 这里先添加唯一索引作为替代
CREATE UNIQUE INDEX IF NOT EXISTS statistics_user_id_unique ON statistics(user_id);
CREATE UNIQUE INDEX IF NOT EXISTS card_type_statistics_user_type_unique ON card_type_statistics(user_id, card_type);
CREATE UNIQUE INDEX IF NOT EXISTS tag_statistics_user_tag_unique ON tag_statistics(user_id, tag_name);

