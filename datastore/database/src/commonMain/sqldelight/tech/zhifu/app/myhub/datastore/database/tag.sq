-- 标签表（用户维度）
CREATE TABLE tag (
    id TEXT PRIMARY KEY NOT NULL,
    user_id TEXT NOT NULL,
    name TEXT NOT NULL,
    created_at TEXT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE
);

CREATE INDEX idx_tag_user_id ON tag(user_id);
CREATE UNIQUE INDEX idx_tag_user_id_name ON tag(user_id, name);

selectTagsByUserId:
SELECT * FROM tag
WHERE user_id = ?
ORDER BY name ASC;

selectTagById:
SELECT * FROM tag
WHERE id = ?;

selectTagByName:
SELECT * FROM tag
WHERE name = ? AND user_id = ?;

insertTag:
INSERT OR REPLACE INTO tag (id, user_id, name, created_at)
VALUES (?, ?, ?, ?);

updateTag:
UPDATE tag
SET name = ?
WHERE id = ? AND user_id = ?;

deleteTag:
DELETE FROM tag
WHERE id = ?;

deleteTagsByUserId:
DELETE FROM tag
WHERE user_id = ?;
