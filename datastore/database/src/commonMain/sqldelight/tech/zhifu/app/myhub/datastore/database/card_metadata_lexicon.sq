-- 词条：发音、释义、例句
CREATE TABLE card_metadata_lexicon (
    card_id TEXT PRIMARY KEY NOT NULL,
    pronunciation TEXT,
    definition TEXT,
    example TEXT,
    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_metadata_lexicon_card_id ON card_metadata_lexicon(card_id);

insertCardMetadataLexicon:
INSERT OR REPLACE INTO card_metadata_lexicon (card_id, pronunciation, definition, example)
VALUES (?, ?, ?, ?);
