-- Video 卡片元数据表
CREATE TABLE card_metadata_video (
  card_id TEXT PRIMARY KEY NOT NULL,
  video_url TEXT NOT NULL,
  thumbnail_url TEXT,
  duration_seconds INTEGER,
  platform TEXT,
  FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

-- 索引
CREATE INDEX idx_card_metadata_video_card_id ON card_metadata_video(card_id);

-- CRUD 操作

-- 查询指定 Card 的 Video 元数据
selectVideoMetadataByCardId:
SELECT * FROM card_metadata_video
WHERE card_id = ?;

-- 插入 Video 元数据
insertVideoMetadata:
INSERT OR REPLACE INTO card_metadata_video (
    card_id,
    video_url,
    thumbnail_url,
    duration_seconds,
    platform
)
VALUES (?, ?, ?, ?, ?);

-- 更新 Video 元数据
updateVideoMetadata:
UPDATE card_metadata_video
SET video_url = ?,
    thumbnail_url = ?,
    duration_seconds = ?,
    platform = ?
WHERE card_id = ?;

-- 删除 Video 元数据
deleteVideoMetadata:
DELETE FROM card_metadata_video
WHERE card_id = ?;
