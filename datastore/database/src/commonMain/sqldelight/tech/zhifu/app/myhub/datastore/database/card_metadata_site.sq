-- 站点名、favicon、站点 ID
CREATE TABLE card_metadata_site (
    card_id TEXT PRIMARY KEY NOT NULL,
    id TEXT,
    name TEXT,
    fav_icon TEXT,
    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_metadata_site_card_id ON card_metadata_site(card_id);

insertCardMetadataSite:
INSERT OR REPLACE INTO card_metadata_site (card_id, id, name, fav_icon)
VALUES (?, ?, ?, ?);
