-- 待办 / 行动项卡片元数据
CREATE TABLE card_metadata_todo (
    card_id TEXT PRIMARY KEY NOT NULL,

    status TEXT NOT NULL DEFAULT 'pending',                     -- pending / completed / cancelled

    priority TEXT,                                              -- low / medium / high

    due_at TEXT,                                                -- 截止时间（ISO-8601）
    completed_at TEXT,                                          -- 完成时间

    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

-- 索引
CREATE INDEX idx_card_metadata_todo_card_id ON card_metadata_todo(card_id);

insertCardMetadataTodo:
INSERT OR REPLACE INTO card_metadata_todo (card_id, status, priority, due_at, completed_at)
VALUES (?, ?, ?, ?, ?);
