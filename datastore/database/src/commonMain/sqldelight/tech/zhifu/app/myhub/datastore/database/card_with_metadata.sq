-- 视图：卡片 + 所有 metadata 表 + 用户主观状态（便于列表/详情查询）
CREATE VIEW card_with_metadata_view AS
SELECT
  c.id         AS card_id,
  c.type       AS card_type,
  c.source     AS card_source,
  c.carriers   AS card_carriers,
  c.user_id    AS card_user_id,
  c.created_at AS card_created_at,
  c.updated_at AS card_updated_at,
  -- card_metadata_content
  md_content.title     AS md_content_title,
  md_content.summary   AS md_content_summary,
  md_content.content   AS md_content_content,
  -- card_metadata_attribution
  md_attr.author    AS md_attr_author,
  md_attr.origin    AS md_attr_origin,
  md_attr.language  AS md_attr_attr_language,
  md_attr.style_key AS md_attr_style_key,
  md_attr.style_color AS md_attr_style_color,
  -- card_metadata_carrier_image
  md_carrier_image.url   AS md_carrier_image_url,
  md_carrier_image.thumbnail_url     AS md_carrier_image_thumbnail_url,
  -- card_metadata_carrier_video
  md_carrier_video.url         AS md_carrier_video_url,
  md_carrier_video.duration  AS md_carrier_video_duration,
  md_carrier_video.platform          AS md_carrier_video_platform,
  md_carrier_video.cover_image_url   AS md_carrier_video_cover_image_url,
  -- card_metadata_code
  md_code.language    AS md_code_language,
  md_code.snippet     AS md_code_snippet,
  -- card_metadata_execution
  md_execution.status      AS md_execution_status,
  md_execution.priority    AS md_execution_priority,
  md_execution.due_at      AS md_execution_due_at,
  md_execution.completed_at AS md_execution_completed_at,
  md_execution.steps       AS md_execution_steps,
  -- card_metadata_lexicon
  md_lexicon.pronunciation AS md_lexicon_pronunciation,
  md_lexicon.definition    AS md_lexicon_definition,
  md_lexicon.example      AS md_lexicon_example,
  -- card_metadata_link
  md_link.url AS md_link_url,
  -- card_metadata_site
  md_site.id          AS md_site_id,
  md_site.name        AS md_site_name,
  md_site.fav_icon AS md_site_fav_icon,
  -- user_card
  uc.is_favorite      AS user_card_is_favorite,
  uc.last_reviewed_at AS user_card_last_reviewed_at
FROM card c
LEFT JOIN card_metadata_content md_content ON md_content.card_id = c.id
LEFT JOIN card_metadata_attribution md_attr ON md_attr.card_id = c.id
LEFT JOIN card_metadata_carrier_image md_carrier_image ON md_carrier_image.card_id = c.id
LEFT JOIN card_metadata_carrier_video md_carrier_video ON md_carrier_video.card_id = c.id
LEFT JOIN card_metadata_code md_code ON md_code.card_id = c.id
LEFT JOIN card_metadata_execution md_execution ON md_execution.card_id = c.id
LEFT JOIN card_metadata_lexicon md_lexicon ON md_lexicon.card_id = c.id
LEFT JOIN card_metadata_link md_link ON md_link.card_id = c.id
LEFT JOIN card_metadata_site md_site ON md_site.card_id = c.id
LEFT JOIN user_card uc ON uc.card_id = c.id AND uc.user_id = c.user_id;

selectCardWithMetadataByCardId:
SELECT v.*
FROM card_with_metadata_view v
WHERE card_id = :cardId;

selectCardWithMetadataByUserId:
SELECT v.*
FROM card_with_metadata_view v
WHERE v.card_user_id = :userId;

selectCardWithMetadataByUserIdWithFilters:
SELECT v.*
FROM card_with_metadata_view v
WHERE v.card_user_id = :userId
  AND (:type IS NULL OR v.card_type = :type)
  AND (:isFavorite IS NULL OR v.user_card_is_favorite = :isFavorite)
ORDER BY v.card_updated_at DESC
LIMIT :limit OFFSET :offset;

countCardWithMetadataByUserIdWithFilters:
SELECT COUNT(*)
FROM card_with_metadata_view v
WHERE v.card_user_id = :userId
  AND (:type IS NULL OR v.card_type = :type)
  AND (:isFavorite IS NULL OR v.user_card_is_favorite = :isFavorite);
