-- 卡片实体表（结构化实体索引）
CREATE TABLE card_entity (
  card_id TEXT NOT NULL,
  entity_type TEXT NOT NULL,
  entity_name TEXT NOT NULL,
  PRIMARY KEY (card_id, entity_type, entity_name),
  FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_entity_card_id ON card_entity(card_id);
CREATE INDEX idx_card_entity_type_name ON card_entity(entity_type, entity_name);

insertCardEntity:
INSERT OR REPLACE INTO card_entity (
  card_id,
  entity_type,
  entity_name
)
VALUES (?, ?, ?);

deleteCardEntitiesByCardId:
DELETE FROM card_entity
WHERE card_id = ?;

selectCardEntitiesByCardId:
SELECT *
FROM card_entity
WHERE card_id = ?;

selectCardIdsByEntity:
SELECT card_id
FROM card_entity
WHERE entity_type = ?
  AND entity_name = ?;
