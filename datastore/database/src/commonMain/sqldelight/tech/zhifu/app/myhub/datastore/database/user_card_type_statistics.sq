-- derived from card + user_card： card JOIN user_card GROUP BY card.type
CREATE TABLE user_card_type_statistics (
    card_type TEXT NOT NULL,

    count INTEGER NOT NULL DEFAULT 0,

    user_id TEXT NOT NULL DEFAULT '',

    PRIMARY KEY (user_id, card_type),
    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE
);

-- 索引
CREATE INDEX idx_user_card_type_statistics_user_id ON user_card_type_statistics(user_id);
CREATE INDEX idx_user_card_type_statistics_card_type ON user_card_type_statistics(card_type);

-- CRUD 操作

selectUserCardTypeStatisticsByUserId:
SELECT * FROM user_card_type_statistics
WHERE user_id = ?
ORDER BY count DESC;

selectUserCardTypeStatisticsById:
SELECT * FROM user_card_type_statistics
WHERE user_id = ? AND card_type = ?;

insertUserCardTypeStatistics:
INSERT OR REPLACE INTO user_card_type_statistics (user_id, card_type, count)
VALUES (?, ?, ?);

updateUserCardTypeStatistics:
UPDATE user_card_type_statistics
SET count = ?
WHERE user_id = ? AND card_type = ?;

deleteUserCardTypeStatistics:
DELETE FROM user_card_type_statistics
WHERE user_id = ? AND card_type = ?;

deleteUserCardTypeStatisticsByUserId:
DELETE FROM user_card_type_statistics
WHERE user_id = ?;
