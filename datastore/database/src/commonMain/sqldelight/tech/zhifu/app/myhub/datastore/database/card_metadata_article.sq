-- 文章 / 链接类卡片元数据
CREATE TABLE card_metadata_article (
    card_id TEXT PRIMARY KEY NOT NULL,

    url TEXT NOT NULL,
    summary TEXT,
    cover_image_url TEXT,
    author TEXT,

    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

-- 索引
CREATE INDEX idx_card_metadata_article_card_id ON card_metadata_article(card_id);

insertCardMetadataArticle:
INSERT OR REPLACE INTO card_metadata_article (card_id, url, summary, cover_image_url, author)
VALUES (?, ?, ?, ?, ?);
