-- 作者/出处/语言
CREATE TABLE card_metadata_attribution (
    card_id TEXT PRIMARY KEY NOT NULL,
    author TEXT,
    origin TEXT,
    language TEXT,
    style_key TEXT,
    style_color TEXT,
    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_metadata_attribution_card_id ON card_metadata_attribution(card_id);

insertCardMetadataAttribution:
INSERT OR REPLACE INTO card_metadata_attribution (card_id, author, origin, language, style_key, style_color)
VALUES (?, ?, ?, ?, ?, ?);
