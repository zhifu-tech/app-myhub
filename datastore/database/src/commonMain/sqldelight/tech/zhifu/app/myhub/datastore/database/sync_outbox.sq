-- 同步 Outbox 表（本地变更队列）
CREATE TABLE sync_outbox (
    id TEXT PRIMARY KEY NOT NULL,
    user_id TEXT NOT NULL,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL, -- INSERT/UPDATE/DELETE
    payload TEXT NOT NULL,   -- JSON string
    sequence INTEGER NOT NULL,
    created_at TEXT NOT NULL,
    status TEXT NOT NULL,    -- PENDING/SUCCESS/FAILED
    retry_count INTEGER NOT NULL DEFAULT 0,
    next_retry_at TEXT,
    last_error TEXT
);

-- 索引

CREATE INDEX idx_sync_outbox_user_status ON sync_outbox(user_id, status);
CREATE INDEX idx_sync_outbox_entity ON sync_outbox(entity_type, entity_id);
CREATE UNIQUE INDEX idx_sync_outbox_user_sequence ON sync_outbox(user_id, sequence);

-- CRUD 操作

selectOutboxById:
SELECT * FROM sync_outbox
WHERE id = ?;

selectOutboxByUserId:
SELECT * FROM sync_outbox
WHERE user_id = ?
ORDER BY sequence ASC;

selectPendingOutboxByUserId:
SELECT * FROM sync_outbox
WHERE user_id = ?
  AND status = ?
ORDER BY sequence ASC;

selectReadyOutboxByUserId:
SELECT * FROM sync_outbox
WHERE user_id = ?
  AND (
    status = ?
    OR (
      status = ?
      AND (next_retry_at IS NULL OR next_retry_at <= ?)
    )
  )
ORDER BY sequence ASC;

insertOutbox:
INSERT OR REPLACE INTO sync_outbox (
    id,
    user_id,
    entity_type,
    entity_id,
    operation,
    payload,
    sequence,
    created_at,
    status,
    retry_count,
    next_retry_at,
    last_error
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateOutboxStatus:
UPDATE sync_outbox
SET status = ?,
    next_retry_at = ?,
    last_error = ?
WHERE id = ?;

incrementOutboxRetry:
UPDATE sync_outbox
SET retry_count = retry_count + 1,
    next_retry_at = ?,
    last_error = ?
WHERE id = ?;

deleteOutboxById:
DELETE FROM sync_outbox
WHERE id = ?;

deleteOutboxByUserId:
DELETE FROM sync_outbox
WHERE user_id = ?;

deleteOutboxByStatusBefore:
DELETE FROM sync_outbox
WHERE user_id = ?
  AND status = ?
  AND created_at < ?;
