-- 用户偏好设置表（用户级，非事实数据）
CREATE TABLE user_preferences (
    user_id TEXT NOT NULL,

    theme TEXT NOT NULL DEFAULT 'system',           -- light / dark / system
    language TEXT NOT NULL DEFAULT 'zh-CN',          -- UI language (BCP-47)
    ai_provider TEXT NOT NULL DEFAULT '{}',          -- AI provider config (json text)

    layout_as_list INTEGER NOT NULL DEFAULT 1,    -- 0=false, 1=true
    sort_as_date INTEGER NOT NULL DEFAULT 1,      -- 0=false, 1=true
    sort_as_name INTEGER NOT NULL DEFAULT 1,      -- 0=false, 1=true

    auto_sync INTEGER NOT NULL DEFAULT 1,         -- 0=false, 1=true
    sync_interval INTEGER NOT NULL DEFAULT 3600000, -- 毫秒

    PRIMARY KEY (user_id),
    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE
);

-- 索引

CREATE INDEX idx_user_preferences_user_id ON user_preferences(user_id);

-- CRUD 操作

selectByUserId:
SELECT * FROM user_preferences
WHERE user_id = ?;

upsert:
INSERT OR REPLACE INTO user_preferences (
    user_id,
    theme,
    language,
    ai_provider,
    layout_as_list,
    sort_as_date,
    sort_as_name,
    auto_sync,
    sync_interval
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTheme:
INSERT INTO user_preferences (
    user_id,
    theme
)
VALUES (
    :user_id,
    :theme
)
ON CONFLICT(user_id) DO UPDATE SET
    theme = excluded.theme;

updateLanguage:
INSERT INTO user_preferences (
    user_id,
    language
)
VALUES (
    :user_id,
    :language
)
ON CONFLICT(user_id) DO UPDATE SET
    language = excluded.language;

updateAiProvider:
INSERT INTO user_preferences (
    user_id,
    ai_provider
)
VALUES (
    :user_id,
    :ai_provider
)
ON CONFLICT(user_id) DO UPDATE SET
    ai_provider = excluded.ai_provider;

updateSort:
INSERT INTO user_preferences (
    user_id,
    sort_as_date,
    sort_as_name
)
VALUES (
    :user_id,
    :sort_as_date,
    :sort_as_name
)
ON CONFLICT(user_id) DO UPDATE SET
    sort_as_date = excluded.sort_as_date,
    sort_as_name = excluded.sort_as_name;

updateLayout:
INSERT INTO user_preferences (
    user_id,
    layout_as_list
)
VALUES (
    :user_id,
    :layout_as_list
)
ON CONFLICT(user_id) DO UPDATE SET
    layout_as_list = excluded.layout_as_list;
