-- 用户偏好设置表（用户级，非事实数据）
CREATE TABLE user_preferences (
    user_id TEXT NOT NULL,

    layout_as_list INTEGER NOT NULL DEFAULT 1,    -- 0=false, 1=true
    sort_as_date INTEGER NOT NULL DEFAULT 1,      -- 0=false, 1=true
    sort_as_name INTEGER NOT NULL DEFAULT 1,      -- 0=false, 1=true

    auto_sync INTEGER NOT NULL DEFAULT 1,         -- 0=false, 1=true
    sync_interval INTEGER NOT NULL DEFAULT 3600000, -- 毫秒

    PRIMARY KEY (user_id),
    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE
);

-- 索引

CREATE INDEX idx_user_preferences_user_id ON user_preferences(user_id);

-- CRUD 操作

selectUserPreferencesByUserId:
SELECT * FROM user_preferences
WHERE user_id = ?;

insertUserPreferences:
INSERT OR REPLACE INTO user_preferences (
    user_id,
    layout_as_list,
    sort_as_date,
    sort_as_name,
    auto_sync,
    sync_interval
)
VALUES (?,  ?, ?, ?, ?, ?);

updateUserPreferences:
UPDATE user_preferences
SET layout_as_list = ?,
    sort_as_date = ?,
    sort_as_name = ?,
     auto_sync = ?,
    sync_interval = ?
WHERE user_id = ?;
