-- 卡片表，内容本体（不包含任何用户主观状态）
CREATE TABLE card (
    id TEXT PRIMARY KEY NOT NULL,

    type TEXT NOT NULL,                         -- text / video / product / ...
    title TEXT,
    content TEXT NOT NULL,

    user_id TEXT NOT NULL,

    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,

    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE
);

-- 索引
CREATE INDEX idx_card_type ON card(type);
CREATE INDEX idx_card_user_id ON card(user_id);
CREATE INDEX idx_card_created_at ON card(created_at);
CREATE INDEX idx_card_updated_at ON card(updated_at);

insertCard:
INSERT OR REPLACE INTO card (id, type, title, content, user_id, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteCard:
DELETE FROM card
WHERE id = ?;

deleteCardsByIds:
DELETE FROM card
WHERE id IN ?;

deleteCardsByUserId:
DELETE FROM card
WHERE user_id = ?;
