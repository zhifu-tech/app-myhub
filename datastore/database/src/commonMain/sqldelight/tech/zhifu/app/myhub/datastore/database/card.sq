selectCardsByUserIdWithTitleDescFirst:
SELECT c.*
FROM card c
JOIN user_card uc ON uc.card_id = c.id
WHERE uc.user_id = :userId
ORDER BY c.title DESC, c.id DESC
LIMIT :limit;

selectCardsByUserIdWithTitleDescNext:
SELECT c.*
FROM card c
JOIN user_card uc ON uc.card_id = c.id
WHERE uc.user_id = :userId
  AND (
    c.title < :cursorTitle
    OR (c.title = :cursorTitle AND c.id < :cursorId)
  )
ORDER BY c.title DESC, c.id DESC
LIMIT :limit;

