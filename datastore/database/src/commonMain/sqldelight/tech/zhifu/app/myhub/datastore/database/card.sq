-- 卡片表（壳：身份、type、source、carriers、归属、时间）
-- type/source 语义由 datastore.model.domain.CardType/CardSource 定义，DB 存 wire string
-- carriers: JSON array, ordered, first = primary carrier
CREATE TABLE card (
    id TEXT PRIMARY KEY NOT NULL,
    type TEXT NOT NULL,
    source TEXT NOT NULL,
    carriers TEXT NOT NULL,
    user_id TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_user_id ON card(user_id);
CREATE INDEX idx_card_type ON card(type);
CREATE INDEX idx_card_source ON card(source);
CREATE INDEX idx_card_created_at ON card(created_at);
CREATE INDEX idx_card_updated_at ON card(updated_at);
CREATE INDEX idx_card_user_id_type ON card(user_id, type);
CREATE INDEX idx_card_user_id_updated_at ON card(user_id, updated_at);

insertCard:
INSERT OR REPLACE INTO card (id, type, source, carriers, user_id, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteCard:
DELETE FROM card
WHERE id = ?;

deleteCardsByIds:
DELETE FROM card
WHERE id IN ?;

deleteCardsByUserId:
DELETE FROM card
WHERE user_id = ?;

selectCardById:
SELECT * FROM card
WHERE id = ?;

selectCardsByUserId:
SELECT * FROM card
WHERE user_id = ?
ORDER BY updated_at DESC;
