-- 以图为主：封面/缩略图
CREATE TABLE card_metadata_carrier_image (
    card_id TEXT PRIMARY KEY NOT NULL,
    url TEXT,
    thumbnail_url TEXT,
    FOREIGN KEY (card_id) REFERENCES card(id) ON DELETE CASCADE
);

CREATE INDEX idx_card_metadata_carrier_image_card_id ON card_metadata_carrier_image(card_id);

insertCardMetadataCarrierImage:
INSERT OR REPLACE INTO card_metadata_carrier_image (card_id, url, thumbnail_url)
VALUES (?, ?, ?);
