-- 用户 × 卡集（权限/角色）
CREATE TABLE user_collection (
    user_id TEXT NOT NULL,
    collection_id TEXT NOT NULL,
    role TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (user_id, collection_id),
    FOREIGN KEY (user_id) REFERENCES user(id) ON DELETE CASCADE,
    FOREIGN KEY (collection_id) REFERENCES collection(id) ON DELETE CASCADE
);

CREATE INDEX idx_user_collection_user_id ON user_collection(user_id);
CREATE INDEX idx_user_collection_collection_id ON user_collection(collection_id);

selectUserCollectionsByUserId:
SELECT * FROM user_collection
WHERE user_id = ?
ORDER BY created_at DESC;

selectUserCollectionsByCollectionId:
SELECT * FROM user_collection
WHERE collection_id = ?;

selectUserCollectionById:
SELECT * FROM user_collection
WHERE user_id = ? AND collection_id = ?;

insertUserCollection:
INSERT OR REPLACE INTO user_collection (user_id, collection_id, role, created_at, updated_at)
VALUES (?, ?, ?, ?, ?);

updateUserCollectionRole:
UPDATE user_collection
SET role = ?,
    updated_at = ?
WHERE user_id = ? AND collection_id = ?;

deleteUserCollection:
DELETE FROM user_collection
WHERE user_id = ? AND collection_id = ?;

deleteUserCollectionsByUserId:
DELETE FROM user_collection
WHERE user_id = ?;

deleteUserCollectionsByCollectionId:
DELETE FROM user_collection
WHERE collection_id = ?;
