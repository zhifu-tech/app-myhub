-- 模板表
CREATE TABLE template (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    card_type TEXT NOT NULL,
    preview_image_url TEXT,
    default_content TEXT,
    default_tags TEXT, -- JSON格式存储标签列表
    usage_count INTEGER NOT NULL DEFAULT 0,
    is_system_template INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    user_id TEXT NOT NULL DEFAULT ''
);

-- 索引
CREATE INDEX template_card_type_index ON template(card_type);
CREATE INDEX template_system_index ON template(is_system_template);
CREATE INDEX template_user_id_index ON template(user_id);
CREATE INDEX template_user_type_index ON template(user_id, card_type);

-- 查询：获取所有模板（包括系统模板和用户模板）
selectAll:
SELECT * FROM template
WHERE user_id = ? OR is_system_template = 1
ORDER BY usage_count DESC, name ASC;

-- 查询：根据ID获取模板（包括系统模板）
selectById:
SELECT * FROM template
WHERE id = ? AND (user_id = ? OR is_system_template = 1);

-- 查询：根据类型获取模板（包括系统模板）
selectByType:
SELECT * FROM template
WHERE card_type = ? AND (user_id = ? OR is_system_template = 1)
ORDER BY usage_count DESC, name ASC;

-- 查询：获取系统模板（所有用户可见）
selectSystemTemplates:
SELECT * FROM template
WHERE is_system_template = 1
ORDER BY name ASC;

-- 查询：获取用户自定义模板
selectUserTemplates:
SELECT * FROM template
WHERE is_system_template = 0 AND user_id = ?
ORDER BY updated_at DESC;

-- 插入模板
insertTemplate:
INSERT INTO template (id, name, description, card_type, preview_image_url, default_content, default_tags, usage_count, is_system_template, created_at, updated_at, user_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- 更新模板（只能更新用户自己的模板，系统模板不能更新）
updateTemplate:
UPDATE template
SET name = ?,
    description = ?,
    card_type = ?,
    preview_image_url = ?,
    default_content = ?,
    default_tags = ?,
    usage_count = ?,
    updated_at = ?
WHERE id = ? AND user_id = ? AND is_system_template = 0;

-- 删除模板（只能删除用户自己的模板，系统模板不能删除）
deleteTemplate:
DELETE FROM template
WHERE id = ? AND user_id = ? AND is_system_template = 0;

-- 删除所有用户模板（按用户，系统模板不会被删除）
deleteAll:
DELETE FROM template
WHERE user_id = ? AND is_system_template = 0;

-- 增加模板使用计数（系统模板和用户模板都可以增加计数）
incrementUsageCount:
UPDATE template
SET usage_count = usage_count + 1
WHERE id = ?;
